// studio-assistant — Wrangler config (Phase 3).
// Top level = local dev. It reaches studio-api only through the STUDIO_API
// service binding, as the signed-in person, carrying ASSISTANT_KEY (D-046).
// Run both locally: wrangler dev -c workers/assistant/wrangler.jsonc -c workers/studio-api/wrangler.jsonc
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "studio-assistant-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  // Workers Logs for every environment (card H, D-178): what failed and why, kept by Cloudflare for a few days.
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "services": [{ "binding": "STUDIO_API", "service": "studio-api-dev" }],
  // Reached only through service bindings (the apps' and the site's Workers): no public address, so nobody can call
  // the visitor route directly and skip the site's limits (Site 3.0 stage 3 security review).
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    // One model for v0 (D-054); Haiku routing comes when the eval shows it holds up.
    "ASSISTANT_MODEL": "claude-sonnet-5-5",
    "ASSISTANT_EFFORT": "low",
    // The draft job looks at a work's cover and drafts its words (Site 3.0).
    "DRAFT_MODEL": "claude-haiku-5-5",
    // The public site's visitor assistant (D-130): Haiku 5.5; move up only if its test answers aren't good enough.
    "VISITOR_MODEL": "claude-haiku-5-5",
    // https://gateway.ai.cloudflare.com/v1/<account id>/<gateway>/anthropic — empty = straight to the API.
    "AI_GATEWAY_URL": ""
  },
  // Secrets (wrangler secret put, or .dev.vars locally — never committed):
  //   ANTHROPIC_API_KEY   the model (Phase 3 OK #1)
  //   ASSISTANT_KEY       the same value as studio-api's ASSISTANT_KEY
  //   AI_GATEWAY_TOKEN    only if the gateway requires authentication

  "env": {
    "staging": {
      "name": "studio-assistant-staging",
      "workers_dev": false,
      "preview_urls": false,
      "services": [{ "binding": "STUDIO_API", "service": "studio-api-staging" }],
      "vars": { "ASSISTANT_MODEL": "claude-sonnet-5-5", "ASSISTANT_EFFORT": "low", "DRAFT_MODEL": "claude-haiku-5-5", "VISITOR_MODEL": "claude-haiku-5-5", "AI_GATEWAY_URL": "" }
    },
    "production": {
      "name": "studio-assistant",
      "workers_dev": false,
      "preview_urls": false,
      "services": [{ "binding": "STUDIO_API", "service": "studio-api" }],
      "vars": { "ASSISTANT_MODEL": "claude-sonnet-5-5", "ASSISTANT_EFFORT": "low", "DRAFT_MODEL": "claude-haiku-5-5", "VISITOR_MODEL": "claude-haiku-5-5", "AI_GATEWAY_URL": "" }
    }
  }
}
