{
  "name": "@studio/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "dev": "wrangler dev",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:tables": "wrangler d1 execute DB --local --command \"SELECT name FROM sqlite_master WHERE type='table' ORDER BY name\"",
    "openapi": "tsx scripts/openapi.ts"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.3",
    "@studio/core": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.12",
    "zod": "^4.6.5"
  }
}
